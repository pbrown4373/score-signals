{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeDNA",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "opening",
    "psychology",
    "story",
    "proof",
    "production",
    "offer",
    "assessment",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "format",
        "duration_seconds"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "advertiser_or_creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_category": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_type",
        "first_spoken_line",
        "first_visual",
        "pattern_interrupt",
        "promise",
        "curiosity_mechanism",
        "confidence"
      ],
      "properties": {
        "hook_type": {
          "type": "string"
        },
        "first_spoken_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_visual": {
          "type": [
            "string",
            "null"
          ]
        },
        "pattern_interrupt": {
          "type": [
            "string",
            "null"
          ]
        },
        "promise": {
          "type": [
            "string",
            "null"
          ]
        },
        "curiosity_mechanism": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "psychology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_desire",
        "primary_problem",
        "emotional_triggers",
        "awareness_stage",
        "objections",
        "identity_signals",
        "confidence"
      ],
      "properties": {
        "primary_desire": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "emotional_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "awareness_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "identity_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_map",
        "conflict",
        "reveal",
        "resolution",
        "cta"
      ],
      "properties": {
        "beat_map": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "role",
              "description"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "conflict": {
          "type": [
            "string",
            "null"
          ]
        },
        "reveal": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "cta": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types",
        "details",
        "confidence"
      ],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_style",
        "creator_archetype",
        "setting",
        "shot_frequency",
        "text_overlays",
        "audio_style",
        "editing_speed",
        "b_roll_usage",
        "product_visibility"
      ],
      "properties": {
        "camera_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "creator_archetype": {
          "type": [
            "string",
            "null"
          ]
        },
        "setting": {
          "type": [
            "string",
            "null"
          ]
        },
        "shot_frequency": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_overlays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "audio_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "editing_speed": {
          "type": [
            "string",
            "null"
          ]
        },
        "b_roll_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_visibility": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "discount",
        "bundle",
        "guarantee",
        "scarcity",
        "trial",
        "cta_style"
      ],
      "properties": {
        "price": {
          "type": [
            "string",
            "null"
          ]
        },
        "discount": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundle": {
          "type": [
            "string",
            "null"
          ]
        },
        "guarantee": {
          "type": [
            "string",
            "null"
          ]
        },
        "scarcity": {
          "type": [
            "string",
            "null"
          ]
        },
        "trial": {
          "type": [
            "string",
            "null"
          ]
        },
        "cta_style": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "why_it_may_work",
        "structural_reusability",
        "brand_specificity",
        "evidence_limitations"
      ],
      "properties": {
        "why_it_may_work": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "structural_reusability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "brand_specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement",
          "confidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "OBSERVED",
              "INFERRED"
            ]
          },
          "statement": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}