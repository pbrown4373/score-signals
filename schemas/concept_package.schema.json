{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "creative_hypothesis",
    "target_persona",
    "awareness_stage",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "creative_hypothesis": {
      "type": "string",
      "minLength": 10
    },
    "target_persona": {
      "type": "string"
    },
    "awareness_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "angle",
          "hook_options",
          "script_30s",
          "beat_map",
          "shot_list",
          "on_screen_text",
          "cta",
          "production_notes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "hook_options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "script_30s": {
            "type": "string"
          },
          "script_60s": {
            "type": [
              "string",
              "null"
            ]
          },
          "beat_map": {
            "type": "array",
            "minItems": 2,
            "maxItems": 15,
            "items": {
              "type": "string"
            }
          },
          "shot_list": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "b_roll": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "on_screen_text": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "cta": {
            "type": "string"
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail_concept": {
            "type": [
              "string",
              "null"
            ]
          },
          "production_notes": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "generation_prompt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}