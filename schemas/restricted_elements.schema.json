{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestrictedElements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "restricted_elements"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "restricted_elements": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element_type", "value", "severity"],
        "properties": {
          "element_type": {
            "enum": [
              "PHRASE",
              "UNIQUE_FACT",
              "METAPHOR",
              "SCENE",
              "CLAIM",
              "NAME",
              "OTHER"
            ]
          },
          "value": { "type": "string", "minLength": 2, "maxLength": 500 },
          "severity": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
